# Raw ESPN captures contain members' personal info; keep local only
data/**/raw/
*.raw.json
# The week-ahead preview for the Coach page: trimmed like any other capture, but a
# throwaway. It is recaptured on every live update and is stale the moment the week
# starts, so it never belongs in a commit.
data/*/next-week/
# ESPN headlines for the Week hub (scripts/fetch_news.py): refetched on every live update and
# ignored by the build once it's 36 hours old, so it never belongs in a commit either.
data/*/news/
.DS_Store
__pycache__/
site/dist/
# Written by `vercel build` when it sets up its Python environment.
pyproject.toml
uv.lock
.vercel
.env*
node_modules/

# Claude Code — per-developer local overrides, never shared
.claude/settings.local.json

# The scheduled Claude workflows' scratch folder (summary, yesterday's snapshot); never committed.
.ci-out/
