# Raw ESPN captures contain members' personal info; keep local only
data/**/raw/
*.raw.json
# The week-ahead preview for the Coach page: trimmed like any other capture, but a
# throwaway. It is recaptured on every live update and is stale the moment the week
# starts, so it never belongs in a commit.
data/*/next-week/
.DS_Store
__pycache__/
site/dist/
# Written by `vercel build` when it sets up its Python environment.
pyproject.toml
uv.lock
.vercel
.env*
# Template only, no real values: see CLAUDE.md's ESPN data source fallback.
!.env.espn.local.example
node_modules/

# Per-manager dashboard link secret. Untracked is not enough: one `git add -A` would
# publish the key every private dashboard URL is derived from, and the URLs already
# handed out can only be rotated by changing it, which breaks all eight at once.
.dashboard-secret
